# Copy to .env_local for local use. Never put actual credentials in Git.
POSTGRES_DB=ai_stock_trader
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_local_postgres_password
POSTGRES_PORT=5432
SERVER_PORT=18080
SERVER_ADDRESS=127.0.0.1
MARKET_AI_BASE_URL=http://127.0.0.1:18000
DATABASE_URL=jdbc:postgresql://localhost:5432/ai_stock_trader

# Optional read-only KIS quote snapshots. Keep disabled until credentials are configured.
KIS_ENVIRONMENT=paper
KIS_MARKET_DATA_ENABLED=false
KIS_REAL_MARKET_DATA_ENABLED=false
KIS_WEBSOCKET_ENABLED=false
# US delayed WebSocket quotes are read-only REAL market data, routed to the local PAPER ledger.
KIS_REAL_WEBSOCKET_MARKET_DATA_ENABLED=false
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NUMBER=
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NUMBER=
KIS_REAL_KR_BUY_COMMISSION_BPS=
KIS_REAL_KR_SELL_COMMISSION_BPS=
KIS_REAL_KR_SELL_TAX_BPS=
KIS_REAL_US_BUY_COMMISSION_BPS=
KIS_REAL_US_SELL_COMMISSION_BPS=
KIS_REAL_US_SELL_TAX_BPS=
# REST calls use a conservative one-second minimum in both Python and Spring.
# Increase locally if the KIS account receives rate-limit responses.
KIS_PAPER_REST_MIN_INTERVAL_SECONDS=1.0
KIS_REAL_REST_MIN_INTERVAL_SECONDS=1.0
# Python and Spring reserve KIS REST request slots in PostgreSQL by environment and app-key fingerprint.
KIS_SHARED_RATE_LIMIT_ENABLED=true
KIS_REAL_ORDERS_ENABLED=false
REAL_SIGNAL_SUBMISSION_ENABLED=false
# Opt-in read-only REAL KR/US signal monitor; order writes need every separate REAL gate.
REAL_SIGNAL_MONITOR_ENABLED=false
REAL_PROTECTIVE_EXIT_MANAGER_ENABLED=false
# Additional independent kill switch for automatic REAL protective SELL orders.
KIS_REAL_PROTECTIVE_EXIT_AUTOMATION_ENABLED=false
KIS_REAL_PROTECTIVE_EXIT_POLL_MS=1000

# Account balance/position snapshots are separately gated and disabled by default.
KIS_ACCOUNT_READ_ENABLED=false
KIS_PAPER_ACCOUNT_READ_ENABLED=false
KIS_REAL_ACCOUNT_READ_ENABLED=false
KIS_REAL_RISK_BASELINE_POLL_MS=30000
KIS_REAL_RECONCILIATION_ENABLED=false
KIS_REAL_RECONCILIATION_DELAY_MS=30000
# Optional read-only REAL fill notices; requires account reads and HTS ID.
KIS_REAL_EXECUTION_NOTICES_ENABLED=false
KIS_REAL_HTS_ID=
KIS_SNAPSHOT_PERSISTENCE_ENABLED=false
KIS_PAPER_ORDERS_ENABLED=false
KIS_CONNECT_TIMEOUT=3s
KIS_READ_TIMEOUT=8s
KIS_MIN_REQUEST_INTERVAL=1s
AI_MODEL_REGISTRY_PATH=.local/models
MODEL_GOVERNANCE_TOKEN=

# P1 safety switches: keep these values.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
MAX_ORDER_NOTIONAL_KRW=1000000
MAX_ORDER_NOTIONAL_USD=100
LIVE_DAILY_LOSS_LIMIT_PCT=1.00
LIVE_TRADE_RISK_EQUITY_PCT=0.25
LIVE_MAX_POSITION_EQUITY_PCT=10.00
LIVE_MAX_OPEN_POSITIONS=3
LIVE_MAX_CONSECUTIVE_LOSSES=3
PAPER_STARTING_CASH_KRW=0
PAPER_STARTING_CASH_USD=0
PAPER_ORDER_TIMEOUT_SECONDS=0
PAPER_COST_MODEL_ENABLED=false
# Enter your own KIS fee rates in basis points before enabling the paper cost model.
PAPER_KR_COMMISSION_BPS=0
PAPER_KR_SELL_COST_BPS=0
PAPER_US_COMMISSION_BPS=0
PAPER_US_SELL_COST_BPS=0
# Required per-market assumptions for quant backtests and model retraining.
# Use reviewed account fees, conservative slippage, and total round-trip cost in basis points.
BACKTEST_KR_BUY_COMMISSION_BPS=
BACKTEST_KR_SELL_COMMISSION_BPS=
BACKTEST_KR_SELL_TAX_BPS=
BACKTEST_KR_SLIPPAGE_BPS=
BACKTEST_KR_ROUND_TRIP_COST_BPS=
BACKTEST_US_BUY_COMMISSION_BPS=
BACKTEST_US_SELL_COMMISSION_BPS=
BACKTEST_US_SELL_TAX_BPS=
BACKTEST_US_SLIPPAGE_BPS=
BACKTEST_US_ROUND_TRIP_COST_BPS=
PAPER_AUTOTRADING_ENABLED=false
PAPER_SESSION_MONITOR_ENABLED=false
PAPER_WATCHLIST=
PAPER_CANDIDATE_SUBSCRIPTIONS_ENABLED=false
PAPER_CANDIDATE_AUTO_REFRESH_ENABLED=false
PAPER_CANDIDATE_MIN_TURNOVER_KRW=
PAPER_CANDIDATE_MIN_TURNOVER_USD=
PAPER_CANDIDATE_US_EXCHANGE=
PAPER_CANDIDATE_LIMIT=10
PAPER_MAX_QUOTE_AGE_SECONDS=3
PAPER_MAX_SIGNAL_BAR_AGE_SECONDS=120
PAPER_DAILY_LOSS_LIMIT_PCT=1.00
PAPER_MAX_POSITION_EQUITY_PCT=10.00
PAPER_TRADE_RISK_EQUITY_PCT=0.25
PAPER_ATR_STOP_MULTIPLE=1.5
PAPER_MAX_OPEN_POSITIONS=3
PAPER_MAX_CONSECUTIVE_LOSSES=3
PAPER_FLATTEN_BEFORE_CLOSE_MINUTES=5
