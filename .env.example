# Copy to .env for local use. Never put actual credentials in Git.
POSTGRES_DB=ai_stock_trader
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_local_postgres_password
POSTGRES_PORT=5432
SERVER_ADDRESS=127.0.0.1
DATABASE_URL=jdbc:postgresql://localhost:5432/ai_stock_trader

# Optional read-only KIS quote snapshots. Keep disabled until credentials are configured.
KIS_ENVIRONMENT=paper
KIS_MARKET_DATA_ENABLED=false
KIS_WEBSOCKET_ENABLED=false
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NUMBER=
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NUMBER=
# REST pacing follows the KIS paper limit and its concurrent-call spacing recommendation.
# These values may be increased locally, but the Python client never goes below the floor.
KIS_PAPER_REST_MIN_INTERVAL_SECONDS=1.0
KIS_REAL_REST_MIN_INTERVAL_SECONDS=0.1
KIS_REAL_ORDERS_ENABLED=false

# Account balance/position snapshots are separately gated and disabled by default.
KIS_ACCOUNT_READ_ENABLED=false
KIS_PAPER_ACCOUNT_READ_ENABLED=false
KIS_REAL_ACCOUNT_READ_ENABLED=false
KIS_REAL_RECONCILIATION_ENABLED=false
KIS_REAL_RECONCILIATION_DELAY_MS=30000
KIS_SNAPSHOT_PERSISTENCE_ENABLED=false
KIS_PAPER_ORDERS_ENABLED=false
KIS_CONNECT_TIMEOUT=3s
KIS_READ_TIMEOUT=8s
KIS_MIN_REQUEST_INTERVAL=100ms
AI_MODEL_REGISTRY_PATH=.local/models
MODEL_GOVERNANCE_TOKEN=

# P1 safety switches: keep these values.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
MAX_ORDER_NOTIONAL_KRW=1000000
MAX_ORDER_NOTIONAL_USD=100
LIVE_DAILY_LOSS_LIMIT_PCT=1.00
LIVE_TRADE_RISK_EQUITY_PCT=0.25
LIVE_MAX_POSITION_EQUITY_PCT=10.00
LIVE_MAX_OPEN_POSITIONS=3
LIVE_MAX_CONSECUTIVE_LOSSES=3
PAPER_STARTING_CASH_KRW=0
PAPER_STARTING_CASH_USD=0
PAPER_ORDER_TIMEOUT_SECONDS=0
PAPER_COST_MODEL_ENABLED=false
# Enter your own KIS fee rates in basis points before enabling the paper cost model.
PAPER_KR_COMMISSION_BPS=0
PAPER_KR_SELL_COST_BPS=0
PAPER_US_COMMISSION_BPS=0
PAPER_US_SELL_COST_BPS=0
PAPER_AUTOTRADING_ENABLED=false
PAPER_SESSION_MONITOR_ENABLED=false
PAPER_WATCHLIST=
PAPER_MAX_QUOTE_AGE_SECONDS=3
PAPER_MAX_SIGNAL_BAR_AGE_SECONDS=120
PAPER_DAILY_LOSS_LIMIT_PCT=1.00
PAPER_MAX_POSITION_EQUITY_PCT=10.00
PAPER_TRADE_RISK_EQUITY_PCT=0.25
PAPER_ATR_STOP_MULTIPLE=1.5
PAPER_MAX_OPEN_POSITIONS=3
PAPER_MAX_CONSECUTIVE_LOSSES=3
PAPER_FLATTEN_BEFORE_CLOSE_MINUTES=5
